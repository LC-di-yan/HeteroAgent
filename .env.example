# ══════════════════════════════════════════════════════════════════════
# HeteroAgent 环境变量样例（与根目录 config.py::Settings 字段一一对应）
#
# 用法：cp .env.example .env 后按环境改写。字段名即环境变量名（大小写不敏感）。
# 这里给出的全部是 config.py 中的默认值 —— 复制出去不会改变行为，
# 生产必改项已标注「生产必填」。布尔值用 true/false（小写）。
# ══════════════════════════════════════════════════════════════════════

# ── 应用标识与服务绑定 ──
APP_NAME=heteroagent
HOST=127.0.0.1                              # 对外提供服务时改 0.0.0.0（容器内由启动命令覆盖）
PORT=8000                                   # 监听端口
DEBUG=false                                 # 调试模式：true 时放开调试端点与详细错误，生产必须 false

# ── LLM 主链路 ──
# 生产必填：模型调用密钥，切勿提交进仓库（默认留空；空值行不能带行尾注释，python-dotenv 会把注释当值）
# 离线演示模式：无 API Key 也能跑通全链路（脚本化假模型 + 关键字知识库），生产必须 false
DEMO_MODE=false

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # 兼容 OpenAI 协议的网关可改此项
MODEL_NAME=gpt-5.1                          # 主力模型（推理/生成）
# 轻量模型：留空则复用 MODEL_NAME（用于分类、改写等低成本任务）
LIGHT_MODEL_NAME=
TEMPERATURE=0                               # 采样温度：0 最确定，客服场景默认关闭随机性
LLM_TIMEOUT_SECONDS=30                      # 单次模型调用超时（秒）
LLM_MAX_RETRIES=2                           # 模型调用失败重试次数（不含首次）

# ── Embedding 与向量化 ──
EMBEDDING_MODEL=text-embedding-3-small      # 向量化模型名
EMBEDDING_DIM=1536                          # 向量维度：必须与 EMBEDDING_MODEL 实际输出一致
EMBEDDING_TIMEOUT_SECONDS=10                # 向量化调用超时（秒）
ALLOW_EMBEDDING_FALLBACK=false              # false=向量化不可用直接报错，禁止静默伪降级（G7）

# ── 检索与重排 ──
RAG_TOP_K=5                                 # 向量召回条数
RAG_RERANK_TOP_K=3                          # 重排后送进提示词的条数
RAG_CONFIDENCE_THRESHOLD=0.30               # 检索置信度阈值（0~1，由真实分数分布校准）
RERANK_ENABLED=false
# 工具调用：模型支持 bind_tools 时，工单动作走 tool_calls（关闭则退回文本解析）
TOOL_CALLING_ENABLED=true
# 跨会话用户事实（工单号等确定性事实写入 LangGraph Store）
CONTEXT_STORE_ENABLED=true                        # 是否启用重排：启用需安装可选依赖 rerank 组
RERANK_MODEL=BAAI/bge-reranker-v2-m3        # 重排模型标识

# ── Redis 短期记忆 ──
REDIS_URL=redis://localhost:6379/0          # 短期记忆与限流后端（生产指向实际 Redis）
SHORT_TERM_TTL_SECONDS=1800                 # 会话短期记忆过期时间（秒）
SHORT_TERM_MAX_TURNS=20                     # 单会话保留最大轮数
MAX_CONTEXT_TOKENS=4000                     # 送进模型的上下文 token 预算

# ── 长期记忆：向量库 ──
VECTOR_STORE_TYPE=faiss                     # faiss | milvus
FAISS_INDEX_PATH=./vector_store/faiss_index # FAISS 索引目录（不进镜像，运行时重建）
MILVUS_HOST=localhost                       # VECTOR_STORE_TYPE=milvus 时生效
MILVUS_PORT=19530                           # Milvus 服务端口
MILVUS_COLLECTION=heteroagent_docs          # Milvus 集合名

# ── 接口安全（G9）──
# 逗号分隔的调用方密钥列表；生产必填（配合 REQUIRE_AUTH=true）
API_KEYS=
REQUIRE_AUTH=false                          # 是否强制鉴权：生产必须 true
RATE_LIMIT_PER_MINUTE=60
# 多副本共享配额：memory（默认，进程内）或 redis
RATE_LIMIT_BACKEND=memory                    # 每调用方每分钟请求上限
MAX_BODY_BYTES=1000000                      # 请求体字节上限（防超大 payload 打满内存）
MAX_MESSAGE_CHARS=8000                      # 单条消息字符上限
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 安全护栏（T-P2-08）：在规则检测之上叠加模型分类器（Llama Guard / Prompt Guard / 内部风控）
GUARDRAIL_ENABLED=false
GUARDRAIL_ENDPOINT=
GUARDRAIL_API_KEY=
GUARDRAIL_TIMEOUT_SECONDS=3
# 分类器不可用时：false=放行（可用性优先），true=拦截（合规优先）
GUARDRAIL_FAIL_CLOSED=false  # 逗号分隔白名单，生产按实际域名收紧

# ── 人工审批 HITL ──
APPROVAL_STORE=memory                       # memory | redis：多副本部署必须 redis
APPROVAL_TTL_SECONDS=86400                  # 待审批记录保留时间（秒）
COMPLIANCE_NEGATION_WINDOW=8                # 合规否定词检测的回看窗口（词数）

# ── LangGraph 检查点 ──
CHECKPOINT_BACKEND=sqlite                   # memory | sqlite：重启需持久化则 sqlite
CHECKPOINT_PATH=./var/checkpoints.db
# 多副本共享 HITL 状态：CHECKPOINT_BACKEND=postgres 时必填（需装可选依赖 postgres）
POSTGRES_DSN=        # sqlite 检查点文件路径（var/ 不进镜像）
CHECKPOINT_RETENTION_DAYS=14                # 检查点保留天数

# ── 可观测 OpenTelemetry（G13）──
# Prometheus 文本端点 /metrics 是否公开（默认需鉴权）
METRICS_PUBLIC=false

OTEL_SERVICE_NAME=heteroagent               # 上报的服务名
# OTLP Collector 地址，留空则不导出（示例：http://localhost:4317）
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_always_on   # 采样策略，必须被实际读取
OTEL_CONSOLE_EXPORT=false                   # true 时 trace 打到 stdout，仅限本地排查

# ── 调试端点 ──
ENABLE_DEBUG_TOOL_ENDPOINTS=false           # 工具直调调试端点开关：生产必须 false
